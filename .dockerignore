# Only read when building deploy/space/Dockerfile with the repo root as context (e.g. a
# local `docker build -f deploy/space/Dockerfile .` sanity check). The real deploy path
# (.github/workflows/space.yml) never needs this: it stages a curated subtree - already
# just atrium_sim/, webviz/, train/, baselines/, plans/, runs/**/ckpt.pt, pyproject.toml,
# uv.lock - as the actual build context, so most of what's excluded below was never in it.
.git
.venv
node_modules
frontend/node_modules
frontend/.next
frontend/out
runs/**/*.gif
runs/**/events.out.tfevents.*
runs/**/*.log
media
tests
__pycache__
**/__pycache__
*.pyc
